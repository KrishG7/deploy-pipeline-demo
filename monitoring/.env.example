# Copy to monitoring/.env (gitignored). Used by kuma-setup.mjs and scripts/disk-alert.sh.
KUMA_URL=http://127.0.0.1:3001
KUMA_ADMIN_USER=admin
# KUMA_ADMIN_PASSWORD=<generate with: openssl rand -hex 16>
ALERT_SMTP_URL=smtp://127.0.0.1:1025
ALERT_FROM=<sender address for alerts>
ALERT_TO=<on-call mailbox>
