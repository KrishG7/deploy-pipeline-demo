# Static file server inside the web image. Plain HTTP on 8080: TLS is
# terminated by the front Caddy in deploy/compose.yml.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode gzip
	try_files {path} /index.html
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	file_server
}
