# Production settings. deploy/write-env.sh turns this template into the real env
# file by appending the secrets (from GitHub environment secrets in CI, or your
# shell locally). Never commit the generated file.
APP_ENV=production
SITE_DOMAIN=app.localhost
CADDY_TLS=tls internal
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_PREFIX=ghcr.io/<github-owner>/deploy-pipeline-demo
POSTGRES_DB=appointments
POSTGRES_USER=appointments
SEED_ON_START=true
BACKUP_SCHEDULE=0 2 * * *
RETAIN_DAILY=7
RETAIN_WEEKLY=4
S3_ENDPOINT=http://host.docker.internal:9000
S3_BUCKET=backups
S3_ACCESS_KEY=production-backup

# Secrets (added by write-env.sh, shown here only as placeholders):
# POSTGRES_PASSWORD=<generate with: openssl rand -hex 24>
# S3_SECRET_KEY=<secret for the production-backup bucket user>
